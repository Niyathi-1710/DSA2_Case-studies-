import java.util.Arrays;

public class BellmanFord {

    static class Edge {
        int source, destination, weight;

        Edge(int source, int destination, int weight) {
            this.source = source;
            this.destination = destination;
            this.weight = weight;
        }
    }

    public static void main(String[] args) {

        // Graph: 6 hubs (0=Warehouse, 1=Hub-N, 2=Hub-E, 3=Hub-S, 4=Hub-W, 5=Hub-C)
        Edge[] edges = {
            new Edge(0, 1,  6),
            new Edge(0, 2,  7),
            new Edge(1, 2,  8),
            new Edge(1, 3, -4),   // negative weight (congestion rebate)
            new Edge(1, 4,  5),
            new Edge(2, 3,  2),
            new Edge(2, 4, -3),   // negative weight (congestion rebate)
            new Edge(3, 5,  2),
            new Edge(4, 0,  2),
            new Edge(4, 5,  9),
            new Edge(5, 3,  7)
        };

        int totalVertices = 6;
        int[] dist = new int[totalVertices];
        Arrays.fill(dist, Integer.MAX_VALUE);
        dist[0] = 0;  // source = Warehouse

        // Step 1: Relax all edges (V - 1) times
        for (int i = 1; i < totalVertices; i++) {
            for (Edge e : edges) {
                if (dist[e.source] != Integer.MAX_VALUE &&
                    dist[e.source] + e.weight < dist[e.destination]) {
                    dist[e.destination] = dist[e.source] + e.weight;
                }
            }
        }

        // Step 2: Check for negative-weight cycles (V-th relaxation)
        for (Edge e : edges) {
            if (dist[e.source] != Integer.MAX_VALUE &&
                dist[e.source] + e.weight < dist[e.destination]) {
                System.out.println("Negative-weight cycle detected! Routing undefined.");
                return;
            }
        }

        // Step 3: Print shortest distances
        String[] hubNames = {"Warehouse", "Hub-N", "Hub-E", "Hub-S", "Hub-W", "Hub-C"};
        System.out.println("Shortest distances from Warehouse:");
        System.out.println("----------------------------------");
        for (int i = 0; i < totalVertices; i++) {
            System.out.printf("-> %-12s : %d min%n", hubNames[i], dist[i]);
        }
    }
}
